<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ShinCapture</AssemblyName>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <RootNamespace>ShinCapture</RootNamespace>
    <Version>1.3.19</Version>
    <Product>ShinCapture</Product>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- 실행 파일 용량을 줄인다. 관리 어셈블리 압축 해제는 실행마다 비용이 발생한다. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- ReadyToRun 사전 컴파일을 생략한다. 용량과 시작 시간의 차이는 별도 실측이 필요하다. -->
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.10.*" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.10.*" />
    <PackageReference Include="System.Drawing.Common" Version="8.*" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.*" />
    <PackageReference Include="System.Windows.Extensions" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>

  <!-- Only still-image processing is used. FFmpeg is an optional video-I/O
       plugin; exclude it before the single-file bundle is assembled. -->
  <Target Name="ExcludeUnusedOpenCvVideoRuntime" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(ResolvedFileToPublish.Filename)').StartsWith('opencv_videoio_ffmpeg'))" />
    </ItemGroup>
  </Target>

</Project>
